# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
build/
dist/

# Secrets
.env
*.token
kaggle.json

# Data and outputs never go in git. The only committed data are the frozen split id lists.
data/*
!data/splits/
!data/splits/**
outputs/
runs/
wandb/
*.safetensors
*.bin
*.pt
*.gguf
checkpoints/
adapters/
# Validation sheets hold full prompts and responses: everything under validation/ but the guidelines
# stays out (validation/*, since git cannot re-include a file under an excluded folder), and so does
# a returned sheet saved in the root, where `--file filled.csv` is read.
validation/*
!validation/guidelines.md
/*.csv

# Notebooks' scratch
.ipynb_checkpoints/
/kaggle/working/

# OS / editors
.DS_Store
.idea/
.vscode/
