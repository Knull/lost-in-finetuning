# Copy to .env (never commit it). On Kaggle, add these as notebook secrets instead.
HF_TOKEN=            # needs accepted access to CohereLabs/tiny-aya-global and tiny-aya-base
GITHUB_TOKEN=        # fine-grained, read access to this repo (Kaggle clones it)
OPENAI_API_KEY=      # frontier judge, if OpenAI is the provider
ANTHROPIC_API_KEY=   # frontier judge, if Anthropic is the provider
LIFT_DATA_DIR=       # optional override, e.g. /kaggle/working/data
LIFT_OUTPUT_DIR=     # optional override, e.g. /kaggle/working/outputs
LIFT_RUNS_REPO=      # private HF dataset repo that syncs outputs between machines, e.g. <hf-user>/lift-runs
