# The secrets and settings lift reads from the environment. Nothing reads a .env file: set them in
# the shell that runs lift (PowerShell: $env:HF_TOKEN = "..."), or as notebook secrets on Kaggle.
# lift remote reads them from the laptop's environment and hands them to the Colab VM without
# logging them. Never commit real values.
HF_TOKEN=            # accepted access to CohereLabs/tiny-aya-global and tiny-aya-base, and WRITE access
                     # to LIFT_RUNS_REPO (a read token fails every lift sync push)
GITHUB_TOKEN=        # fine-grained, read access to this repo (the GPU runtimes clone it)
OPENAI_API_KEY=      # frontier judge, if OpenAI is the provider
ANTHROPIC_API_KEY=   # frontier judge, if Anthropic is the provider
LIFT_JUDGE_MAX_USD=  # spend cap in USD for ONE lift process (each `lift judge` line starts at 0); required for the frontier judge
LIFT_DATA_DIR=       # optional override (the Kaggle runner uses /kaggle/temp/lift/data)
LIFT_OUTPUT_DIR=     # optional override (the Kaggle runner uses /kaggle/temp/lift/outputs)
LIFT_VALIDATION_DIR= # optional override (the Kaggle runner uses /kaggle/temp/lift/validation)
LIFT_RUNS_REPO=      # PRIVATE HF dataset repo that syncs outputs between machines, e.g. <hf-user>/lift-runs
