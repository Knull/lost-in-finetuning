# The secrets and settings lift reads from the environment. Nothing reads a .env file: set them in
# the shell that runs lift, each secret with a hidden prompt, never typed or pasted on a command line
# or into a chat (colab/README.md, step 6), or as notebook secrets on Kaggle. PowerShell:
#   $env:HF_TOKEN = [Net.NetworkCredential]::new('', (Read-Host -AsSecureString 'HF_TOKEN')).Password
# bash: `read -rs HF_TOKEN; export HF_TOKEN`. For Claude Code sessions, store each secret once in your
# own PowerShell window, encrypted for your Windows account (Export-Clixml uses DPAPI):
#   New-Item -ItemType Directory -Force "$env:USERPROFILE\.lift"
#   Read-Host -AsSecureString 'HF_TOKEN' | Export-Clixml "$env:USERPROFILE\.lift\HF_TOKEN.xml"
# A session never asks for a secret in the chat: it loads one only in the command line that runs lift,
#   $env:HF_TOKEN = [Net.NetworkCredential]::new('', (Import-Clixml "$env:USERPROFILE\.lift\HF_TOKEN.xml")).Password; lift remote ...
# and asks the user to store it in their own terminal when it is not there. Never keep a secret at user
# scope: every process started afterwards inherits it, a local pip install's build code included. In
# your own window, remove one an earlier step 6 put there, and a stored one you no longer need:
#   [Environment]::SetEnvironmentVariable('HF_TOKEN', $null, 'User')
#   Remove-Item "$env:USERPROFILE\.lift\HF_TOKEN.xml"
# The settings (LIFT_RUNS_REPO, LIFT_JUDGE_MAX_USD) may be set at user scope. lift remote reads them
# from the laptop's environment and hands them to the Colab VM without logging them. Never commit real
# values.
HF_TOKEN=            # accepted access to CohereLabs/tiny-aya-global and tiny-aya-base, and WRITE access
                     # to LIFT_RUNS_REPO (a read token fails every lift sync push)
GITHUB_TOKEN=        # fine-grained, read access to this repo (the GPU runtimes clone it)
OPENAI_API_KEY=      # frontier judge, if OpenAI is the provider
ANTHROPIC_API_KEY=   # frontier judge, if Anthropic is the provider
LIFT_JUDGE_MAX_USD=  # spend cap in USD for ONE lift process (each `lift judge` line starts at 0); required for the frontier judge
GOOGLE_TRANSLATE_API_KEY= # Cloud Translation API key, only for `lift data build` runs that translate (a laptop
                          # step: lift remote does not send it); a secret: a hidden prompt, as above
LIFT_DATA_DIR=       # optional override (the Kaggle runner uses /kaggle/temp/lift/data)
LIFT_OUTPUT_DIR=     # optional override (the Kaggle runner uses /kaggle/temp/lift/outputs)
LIFT_VALIDATION_DIR= # optional override (the Kaggle runner uses /kaggle/temp/lift/validation)
LIFT_RUNS_REPO=      # PRIVATE HF dataset repo that syncs outputs between machines, e.g. <hf-user>/lift-runs
